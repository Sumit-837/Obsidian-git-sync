   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from math import log\n",
    "\n",
    "plt.rcParams['figure.dpi'] = 120\n",
    "plt.rcParams['axes.grid'] = True"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Utility functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def rk4_step(f, t, y, h, *args):\n",
    "    k1 = f(t, y, *args)\n",
    "    k2 = f(t + 0.5*h, y + 0.5*h*k1, *args)\n",
    "    k3 = f(t + 0.5*h, y + 0.5*h*k2, *args)\n",
    "    k4 = f(t + h, y + h*k3, *args)\n",
    "    return y + (h/6.0)*(k1 + 2*k2 + 2*k3 + k4)\n",
    "\n",
    "def integrate_rk4(f, t0, t1, y0, h, args=()):\n",
    "    N = int(np.floor((t1 - t0)/h)) + 1\n",
    "    ts = t0 + h*np.arange(N)\n",
    "    ys = np.zeros((N, np.size(y0)), dtype=float)\n",
    "    y = np.array(y0, dtype=float)\n",
    "    ys[0] = y\n",
    "    for i in range(N-1):\n",
    "        y = rk4_step(f, ts[i], y, h, *args)\n",
    "        ys[i+1] = y\n",
    "    return ts, ys\n",
    "\n",
    "def bisection_root(g, a, b, tol=1e-6, maxit=200):\n",
    "    fa, fb = g(a), g(b)\n",
    "    if fa*fb > 0:\n",
    "        raise ValueError('Bisection bracket does not straddle root.')\n",
    "    for _ in range(maxit):\n",
    "        c = 0.5*(a+b)\n",
    "        fc = g(c)\n",
    "        if abs(fc) < tol or 0.5*(b-a) < tol:\n",
    "            return c\n",
    "        if fa*fc <= 0:\n",
    "            b, fb = c, fc\n",
    "        else:\n",
    "            a, fa = c, fc\n",
    "    return 0.5*(a+b)\n",
    "\n",
    "def trapz_uniform(y, h):\n",
    "    return h*(0.5*y[0] + np.sum(y[1:-1]) + 0.5*y[-1])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Q1) Dynamics of a Rocket with Drag"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Given parameters:\n",
    "- $m_0=1$ kg, $\\alpha=1$ kg s$^{-1}$, $v_{\\mathrm{rel}}=1$ m s$^{-1}$\n",
    "- drag cases: $\\gamma\\in\\{0,\\alpha/2,\\alpha\\} = \\{0,0.5,1\\}$\n",
    "\n",
    "Fuel exhaustion time: $T = m_0/\\alpha = 1$ s.\n",
    "\n",
    "Mass profile:\n",
    "$$\n",
    "m(t)=\\begin{cases}\n",
    "2m_0-\\alpha t, & 0\\le t\\le T\\\\\n",
    "m_0, & T<t\\le 2T\n",
    "\\end{cases}\n",
    "$$\n",
    "\n",
    "Phase 1 ODE:\n",
    "$$\n",
    "(2m_0-\\alpha t)\\frac{dv}{dt}=v_{\\mathrm{rel}}\\alpha-\\gamma v.\n",
    "$$\n",
    "Phase 2 ODE:\n",
    "$$\n",
    "m_0\\frac{dv}{dt}=-\\gamma v.\n",
    "$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q1 parameters\n",
    "m0 = 1.0\n",
    "alpha = 1.0\n",
    "vrel = 1.0\n",
    "gammas = [0.0, alpha/2, alpha]\n",
    "T = m0/alpha\n",
    "t0, t1 = 0.0, 2*T\n",
    "dt = 1e-3\n",
    "\n",
    "print('T =', T)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Analytical solutions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def v_phase1_analytic(t, gamma):\n",
    "    t = np.asarray(t)\n",
    "    if gamma == 0:\n",
    "        # Tsiołkovsky limit\n",
    "        return vrel*np.log((2*m0)/(2*m0 - alpha*t))\n",
    "    else:\n",
    "        return (vrel*alpha/gamma)*(1.0 - (1.0 - t/(2*T))**(gamma/alpha))\n",
    "\n",
    "def v_analytic_piecewise(t, gamma):\n",
    "    t = np.asarray(t)\n",
    "    v = np.zeros_like(t, dtype=float)\n",
    "    mask1 = (t <= T)\n",
    "    mask2 = ~mask1\n",
    "\n",
    "    v[mask1] = v_phase1_analytic(t[mask1], gamma)\n",
    "\n",
    "    vT = v_phase1_analytic(np.array([T]), gamma)[0]\n",
    "    if gamma == 0:\n",
    "        v[mask2] = vT\n",
    "    else:\n",
    "        v[mask2] = vT*np.exp(-(gamma/m0)*(t[mask2]-T))\n",
    "    return v\n",
    "\n",
    "def x_analytic_piecewise(t, gamma):\n",
    "    # numerical integral of analytic v for convenience and robustness\n",
    "    t = np.asarray(t)\n",
    "    v = v_analytic_piecewise(t, gamma)\n",
    "    x = np.zeros_like(t)\n",
    "    for i in range(1, len(t)):\n",
    "        h = t[i]-t[i-1]\n",
    "        x[i] = x[i-1] + 0.5*h*(v[i]+v[i-1])\n",
    "    return x, v"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### RK4 numerical integration (two phases)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def rocket_rhs_phase1(t, Y, gamma):\n",
    "    x, v = Y\n",
    "    m = 2*m0 - alpha*t\n",
    "    dv = (vrel*alpha - gamma*v)/m\n",
    "    return np.array([v, dv], dtype=float)\n",
    "\n",
    "def rocket_rhs_phase2(t, Y, gamma):\n",
    "    x, v = Y\n",
    "    dv = -(gamma/m0)*v\n",
    "    return np.array([v, dv], dtype=float)\n",
    "\n",
    "def integrate_rocket_rk4(gamma, dt=1e-3):\n",
    "    # phase 1\n",
    "    tA, YA = integrate_rk4(rocket_rhs_phase1, 0.0, T, [0.0, 0.0], dt, args=(gamma,))\n",
    "    # phase 2 (handoff from final phase1 state)\n",
    "    tB, YB = integrate_rk4(rocket_rhs_phase2, T, 2*T, YA[-1], dt, args=(gamma,))\n",
    "\n",
    "    # combine without duplicating t=T\n",
    "    t = np.concatenate([tA, tB[1:]])\n",
    "    Y = np.vstack([YA, YB[1:]])\n",
    "    return t, Y[:,0], Y[:,1]\n",
    "\n",
    "q1_data = {}\n",
    "for g in gammas:\n",
    "    t_num, x_num, v_num = integrate_rocket_rk4(g, dt)\n",
    "    v_an = v_analytic_piecewise(t_num, g)\n",
    "    x_an, _ = x_analytic_piecewise(t_num, g)\n",
    "    q1_data[g] = dict(t=t_num, x_num=x_num, v_num=v_num, v_an=v_an, x_an=x_an)\n",
    "    print(f'gamma={g:.3f}: max|v_num-v_an|={np.max(np.abs(v_num-v_an)):.3e}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q1(f) velocity overlay\n",
    "fig, ax = plt.subplots(figsize=(7,4))\n",
    "for g in gammas:\n",
    "    D = q1_data[g]\n",
    "    ax.plot(D['t'], D['v_num'], '-', lw=2, label=f'RK4, gamma={g}')\n",
    "    ax.plot(D['t'], D['v_an'], '--', lw=1.5, label=f'Analytic, gamma={g}')\n",
    "ax.set_xlabel('t (s)')\n",
    "ax.set_ylabel('v(t) (m/s)')\n",
    "ax.set_title('Q1: Rocket velocity vs time')\n",
    "ax.legend(fontsize=8, ncol=2)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q1(h) position overlay\n",
    "fig, ax = plt.subplots(figsize=(7,4))\n",
    "for g in gammas:\n",
    "    D = q1_data[g]\n",
    "    ax.plot(D['t'], D['x_num'], '-', lw=2, label=f'RK4, gamma={g}')\n",
    "    ax.plot(D['t'], D['x_an'], '--', lw=1.5, label=f'Analytic, gamma={g}')\n",
    "ax.set_xlabel('t (s)')\n",
    "ax.set_ylabel('x(t) (m)')\n",
    "ax.set_title('Q1: Rocket position vs time')\n",
    "ax.legend(fontsize=8, ncol=2)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Q1(g) Terminal velocity in phase 1 (formal)\n",
    "\n",
    "For long phase-1 continuation (formal), from\n",
    "$$\n",
    "(2m_0-\\alpha t)\\dot v = v_{rel}\\alpha - \\gamma v,\n",
    "$$\n",
    "instantaneous balance gives\n",
    "$$\n",
    "v_{term}(t)=\\frac{v_{rel}\\alpha}{\\gamma},\\quad (\\gamma\\neq0).\n",
    "$$\n",
    "\n",
    "Numerically for this test:\n",
    "- $\\gamma=0.5$: $v_{term}=2$ m/s\n",
    "- $\\gamma=1.0$: $v_{term}=1$ m/s\n",
    "- $\\gamma=0$: no finite drag-defined terminal value."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Q2) Verifying Stokes’ law"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Given:\n",
    "- radius $r=1.5\\times10^{-3}$ m\n",
    "- sphere density $\\rho_s=7800$ kg m$^{-3}$\n",
    "- fluid density $\\rho_f=1260$ kg m$^{-3}$\n",
    "- viscosity $\\eta=1.49$ Pa s\n",
    "- $g=9.81$ m s$^{-2}$\n",
    "\n",
    "Model:\n",
    "$$\n",
    "\\frac{dv}{dt}=\\frac{v_T-v}{\\tau},\\quad\n",
    "\\tau=\\frac{2\\rho_s r^2}{9\\eta},\\quad\n",
    "v_T=\\frac{2r^2g(\\rho_s-\\rho_f)}{9\\eta}.\n",
    "$$\n",
    "\n",
    "Analytical solution ($v(0)=0$):\n",
    "$$\n",
    "v(t)=v_T(1-e^{-t/\\tau}),\\quad\n",
    "t^*=\\tau\\ln 100\\text{ for }v=0.99v_T.\n",
    "$$\n",
    "Depth with $x(0)=0$:\n",
    "$$\n",
    "x(t)=v_T\\left[t-\\tau(1-e^{-t/\\tau})\\right].\n",
    "$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "r = 1.5e-3\n",
    "rho_s = 7800.0\n",
    "rho_f = 1260.0\n",
    "eta = 1.49\n",
    "g = 9.81\n",
    "\n",
    "tau = 2*rho_s*r*r/(9*eta)\n",
    "vT = 2*r*r*g*(rho_s-rho_f)/(9*eta)\n",
    "t_star_an = tau*np.log(100.0)\n",
    "\n",
    "print(f'tau   = {tau:.6e} s')\n",
    "print(f'vT    = {vT:.6e} m/s')\n",
    "print(f't*an  = {t_star_an:.6e} s')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def v_stokes_analytic(t):\n",
    "    return vT*(1.0 - np.exp(-t/tau))\n",
    "\n",
    "def x_stokes_analytic(t):\n",
    "    return vT*(t - tau*(1.0 - np.exp(-t/tau)))\n",
    "\n",
    "def stokes_rhs(t, Y):\n",
    "    x, v = Y\n",
    "    dv = (vT - v)/tau\n",
    "    return np.array([v, dv], dtype=float)\n",
    "\n",
    "t_end = 2.0\n",
    "dt = 1e-3\n",
    "t2, Y2 = integrate_rk4(stokes_rhs, 0.0, t_end, [0.0, 0.0], dt)\n",
    "x2_num, v2_num = Y2[:,0], Y2[:,1]\n",
    "\n",
    "v2_an = v_stokes_analytic(t2)\n",
    "x2_an = x_stokes_analytic(t2)\n",
    "\n",
    "print('max|v_num-v_an| =', np.max(np.abs(v2_num-v2_an)))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q2(c)(i): compare numerical and analytical v(t)\n",
    "fig, ax = plt.subplots(figsize=(7,4))\n",
    "ax.plot(t2, v2_num, 'b-', lw=2, label='RK4')\n",
    "ax.plot(t2, v2_an, 'r--', lw=2, label='Analytical')\n",
    "ax.set_xlabel('t (s)')\n",
    "ax.set_ylabel('v(t) (m/s)')\n",
    "ax.set_title('Q2: Stokes-law velocity')\n",
    "ax.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q2(c)(ii): bisection for t* where v(t*) = 0.99 vT\n",
    "target = 0.99*vT\n",
    "interp = lambda t: np.interp(t, t2, v2_num) - target\n",
    "t_star_num = bisection_root(interp, 0.0, t_end, tol=1e-10)\n",
    "print('t*_num =', t_star_num)\n",
    "print('t*_an  =', t_star_an)\n",
    "print('abs diff =', abs(t_star_num - t_star_an))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q2(c)(iii): depth at first 0.99 vT via trapezoidal rule up to t*_num\n",
    "mask = t2 <= t_star_num\n",
    "t_seg = t2[mask]\n",
    "v_seg = v2_num[mask]\n",
    "h = t_seg[1] - t_seg[0]\n",
    "x_star_num = trapz_uniform(v_seg, h)\n",
    "x_star_an = x_stokes_analytic(t_star_an)\n",
    "\n",
    "print('x*_num =', x_star_num)\n",
    "print('x*_an  =', x_star_an)\n",
    "print('abs diff =', abs(x_star_num - x_star_an))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Q3) Damped Oscillation in Asymmetric Double-Gaussian Potential"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Given:\n",
    "- $m=1$, $V_1=3$, $\\sigma_1=0.5$, $V_2=5$, $\\sigma_2=0.4$, $b=1$\n",
    "- $\\gamma=0.3$, $x_0=-0.5$, $v_0=2$, integrate to $t=30$ with $\\Delta t=10^{-3}$\n",
    "\n",
    "Potential:\n",
    "$$\n",
    "V(x)=V_1\\exp\\left(-\\frac{(x+b)^2}{2\\sigma_1^2}\\right)+V_2\\exp\\left(-\\frac{(x-b)^2}{2\\sigma_2^2}\\right)\n",
    "$$\n",
    "Equation of motion:\n",
    "$$\n",
    "\\dot x=v,\\qquad\n",
    "\\dot v=\\frac{1}{m}\\left(-\\frac{dV}{dx}-\\gamma v\\right)\n",
    "$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "m = 1.0\n",
    "V1, s1 = 3.0, 0.5\n",
    "V2, s2 = 5.0, 0.4\n",
    "b = 1.0\n",
    "gamma = 0.3\n",
    "x0, v0 = -0.5, 2.0\n",
    "\n",
    "def V(x):\n",
    "    return V1*np.exp(-((x+b)**2)/(2*s1**2)) + V2*np.exp(-((x-b)**2)/(2*s2**2))\n",
    "\n",
    "def dVdx(x):\n",
    "    term1 = -(V1*(x+b)/(s1**2))*np.exp(-((x+b)**2)/(2*s1**2))\n",
    "    term2 = -(V2*(x-b)/(s2**2))*np.exp(-((x-b)**2)/(2*s2**2))\n",
    "    return term1 + term2\n",
    "\n",
    "def damped_rhs(t, Y, gam):\n",
    "    x, v = Y\n",
    "    dv = (-dVdx(x) - gam*v)/m\n",
    "    return np.array([v, dv], dtype=float)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q3(a): potential landscape and initial energy\n",
    "xg = np.linspace(-3, 3, 2000)\n",
    "Vg = V(xg)\n",
    "\n",
    "i_left = np.argmin(np.abs(xg + b))\n",
    "i_right = np.argmin(np.abs(xg - b))\n",
    "x_floor = xg[np.argmin(Vg)]\n",
    "\n",
    "E0 = 0.5*m*v0**2 + V(x0)\n",
    "\n",
    "print(f'V(-b≈-1) ~ {Vg[i_left]:.4f}')\n",
    "print(f'V(+b≈+1) ~ {Vg[i_right]:.4f}')\n",
    "print(f'Valley floor near x ~ {x_floor:.4f}, V ~ {V(x_floor):.4f}')\n",
    "print(f'V(x0) = {V(x0):.6f}, E0 = {E0:.6f}')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7,4))\n",
    "ax.plot(xg, Vg, 'k-', lw=2, label='V(x)')\n",
    "ax.axhline(E0, color='r', ls='--', label='E0')\n",
    "ax.scatter([x0], [V(x0)], c='b', s=40, label='initial x0')\n",
    "ax.set_xlabel('x')\n",
    "ax.set_ylabel('V(x)')\n",
    "ax.set_title('Q3(a): Potential and initial energy')\n",
    "ax.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q3(b): RK4 integration for gamma=0.3\n",
    "t3, Y3 = integrate_rk4(damped_rhs, 0.0, 30.0, [x0, v0], 1e-3, args=(gamma,))\n",
    "x3, v3 = Y3[:,0], Y3[:,1]\n",
    "E3 = 0.5*m*v3**2 + V(x3)\n",
    "\n",
    "fig, ax = plt.subplots(2,1, figsize=(8,6), sharex=True)\n",
    "ax[
